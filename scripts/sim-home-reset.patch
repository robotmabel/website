diff --git a/simulation_bridge/tests/test_bridge.py b/simulation_bridge/tests/test_bridge.py
index fa6ca931..6d28d882 100644
--- a/simulation_bridge/tests/test_bridge.py
+++ b/simulation_bridge/tests/test_bridge.py
@@ -170,3 +170,27 @@ def test_realtime_rate(world):
     realtime_hz = 1.0 / w.model.opt.timestep       # 500 Hz at dt=2 ms
     assert s["rateHz"] >= 0.6 * realtime_hz, \
         f"physics too slow: {s['rateHz']} Hz vs {realtime_hz} Hz real-time"
+
+
+def test_gateway_sees_home_before_reanchoring(world, monkeypatch):
+    """A reset must expose home before the controller rebuilds hold references."""
+    from pathlib import Path
+    monkeypatch.syspath_prepend(str(Path(REPO) / "server"))
+    from plant import SimBridgePlant
+    owner, rpc = world
+    rpc.call("reset", wait=True)
+    rpc.call("set_targets", targets={"Lift": 0.48, "Left Arm 2": 0.45})
+    time.sleep(1.0)
+    data = mujoco.MjData(owner.model)
+    plant = SimBridgePlant(owner.model, data, port=rpc.port)
+    plant.read_state()
+    lift = [int(owner.model.joint(n).qposadr[0]) for n in ("Lift Lower", "Lift Upper")]
+    assert sum(data.qpos[i] for i in lift) > 0.40
+    plant.reset()
+    # No sleep: this is exactly when the facade captures its hold references.
+    home = mujoco.MjData(owner.model)
+    if owner.model.nkey:
+        mujoco.mj_resetDataKeyframe(owner.model, home, 0)
+    arm = int(owner.model.joint("Left Arm 2").qposadr[0])
+    assert np.allclose(data.qpos[lift + [arm]], home.qpos[lift + [arm]], atol=0.002)
+    assert not owner.cmd.targets
